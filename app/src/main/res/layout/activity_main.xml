<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Google Map full layar -->
    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!--
        Pin tetap di tengah layar. UJUNG BAWAH pin tepat di pusat layar.
        Dapat di-tap untuk hide/unhide chip koordinat.
    -->
    <ImageView
        android:id="@+id/img_center_pin"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:translationY="-28dp"
        android:scaleType="fitCenter"
        android:elevation="4dp"
        android:src="@drawable/ic_pin"
        android:contentDescription="@string/center_pin" />

    <!--
        Chip koordinat — bawah tengah layar.
        Menampilkan koordinat pusat kamera (posisi pin).
        Tap chip = sembunyikan; tap pin = tampilkan/sembunyikan.
    -->
    <TextView
        android:id="@+id/chip_coords"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_chip_coords"
        android:clickable="true"
        android:focusable="true"
        android:elevation="5dp"
        android:fontFamily="monospace"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:text="@string/coords_placeholder"
        android:textColor="#202124"
        android:textSize="13sp"
        android:contentDescription="@string/coords_chip" />

    <!-- Tombol kanan bawah : autofocus, zoom in, zoom out -->
    <LinearLayout
        android:id="@+id/buttons_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 1. Autofokus + kompas (2 fungsi dalam 1 tap) -->
        <FrameLayout
            android:id="@+id/btn_autofocus"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_fab_circle"
            android:elevation="6dp">

            <ImageView
                android:id="@+id/img_compass"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_compass"
                android:contentDescription="@string/autofocus" />
        </FrameLayout>

        <!-- 2. Zoom in = zoom maksimal -->
        <FrameLayout
            android:id="@+id/btn_zoom_in"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_fab_circle"
            android:elevation="6dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_zoom_in"
                android:contentDescription="@string/zoom_in" />
        </FrameLayout>

        <!-- 3. Zoom out -->
        <FrameLayout
            android:id="@+id/btn_zoom_out"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_fab_circle"
            android:elevation="6dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_zoom_out"
                android:contentDescription="@string/zoom_out" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
