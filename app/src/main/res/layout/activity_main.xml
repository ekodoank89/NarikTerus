<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Google Map full layar -->
    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Pin tengah: pemicu RAHASIA (7x tap) -->
    <ImageView
        android:id="@+id/img_center_pin"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:translationY="-28dp"
        android:scaleType="fitCenter"
        android:elevation="4dp"
        android:src="@drawable/ic_pin"
        android:contentDescription="@string/center_pin" />

    <!-- Chip koordinat GRB — di atas chip GJK -->
    <TextView
        android:id="@+id/chip_coords_grb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="120dp"
        android:background="@drawable/bg_chip_coords"
        android:clickable="true"
        android:focusable="true"
        android:elevation="5dp"
        android:fontFamily="monospace"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:text="@string/coords_placeholder"
        android:textColor="#202124"
        android:textSize="13sp"
        android:visibility="gone"
        android:contentDescription="@string/coords_chip" />

    <!-- Chip koordinat GJK — di atas chip pin -->
    <TextView
        android:id="@+id/chip_coords_gjk"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="74dp"
        android:background="@drawable/bg_chip_coords"
        android:clickable="true"
        android:focusable="true"
        android:elevation="5dp"
        android:fontFamily="monospace"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:text="@string/coords_placeholder"
        android:textColor="#202124"
        android:textSize="13sp"
        android:visibility="gone"
        android:contentDescription="@string/coords_chip" />

    <!-- Chip koordinat pin — paling bawah -->
    <TextView
        android:id="@+id/chip_coords"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_chip_coords"
        android:clickable="true"
        android:focusable="true"
        android:elevation="5dp"
        android:fontFamily="monospace"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:text="@string/coords_placeholder"
        android:textColor="#202124"
        android:textSize="13sp"
        android:contentDescription="@string/coords_chip" />

        <!-- Panel menu rahasia — overlay tengah, bertab CHIP / SET -->
    <FrameLayout
        android:id="@+id/menu_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:minWidth="260dp"
        android:background="@drawable/bg_menu_panel"
        android:elevation="9dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="10dp"
                android:paddingTop="8dp"
                android:paddingBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/secret_menu"
                    android:textColor="#202124"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/btn_close_menu"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_close"
                    android:contentDescription="@string/close_menu" />
            </LinearLayout>

            <!-- Baris tab -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <TextView
                    android:id="@+id/tab_chip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingVertical="10dp"
                    android:text="@string/tab_chip"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tab_set"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingVertical="10dp"
                    android:text="@string/tab_set"
                    android:textSize="14sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1F000000" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- ===== HALAMAN CHIP ===== -->
                    <LinearLayout
                        android:id="@+id/page_chip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/menu_row_chip_pin"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:paddingHorizontal="18dp"
                            android:paddingVertical="13dp"
                            android:textColor="#202124"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/menu_row_chip_grb"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:paddingHorizontal="18dp"
                            android:paddingVertical="13dp"
                            android:textColor="#202124"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/menu_row_chip_gjk"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:paddingHorizontal="18dp"
                            android:paddingVertical="13dp"
                            android:textColor="#202124"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- ===== HALAMAN SET ===== -->
                    <LinearLayout
                        android:id="@+id/page_set"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/row_target_grb"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:orientation="vertical"
                            android:paddingHorizontal="18dp"
                            android:paddingVertical="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/row_target_grb"
                                android:textColor="@color/row_title"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/val_target_grb"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="#202124"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/row_method_grb"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:orientation="vertical"
                            android:paddingHorizontal="18dp"
                            android:paddingVertical="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/row_method_grb"
                                android:textColor="@color/row_title"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/val_method_grb"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="#202124"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/row_target_gjk"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:orientation="vertical"
                            android:paddingHorizontal="18dp"
                            android:paddingVertical="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/row_target_gjk"
                                android:textColor="@color/row_title"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/val_target_gjk"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="#202124"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/row_method_gjk"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:orientation="vertical"
                            android:paddingHorizontal="18dp"
                            android:paddingVertical="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/row_method_gjk"
                                android:textColor="@color/row_title"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/val_method_gjk"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="#202124"
                                android:textSize="14sp" />
                        </LinearLayout>
                        
            <!-- Triger GRB -->
            <LinearLayout
                android:id="@+id/row_trigger_grb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingVertical="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/row_trigger_grb"
                    android:textColor="@color/row_title"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/val_trigger_grb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#202124"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Triger GJK -->
            <LinearLayout
                android:id="@+id/row_trigger_gjk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingVertical="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/row_trigger_gjk"
                    android:textColor="@color/row_title"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/val_trigger_gjk"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#202124"
                    android:textSize="14sp" />
            </LinearLayout>
            
            <!-- Mode auto-stop GRB -->
            <LinearLayout
                android:id="@+id/row_mode_grb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingVertical="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/row_mode_grb"
                    android:textColor="@color/row_title"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/val_mode_grb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#202124"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Mode auto-stop GJK -->
            <LinearLayout
                android:id="@+id/row_mode_gjk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingVertical="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/row_mode_gjk"
                    android:textColor="@color/row_title"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/val_mode_gjk"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#202124"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Izin Notifikasi (Rencana B) -->
            <LinearLayout
                android:id="@+id/row_notif_perm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingVertical="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/row_notif_perm"
                    android:textColor="@color/row_title"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/val_notif_perm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#202124"
                    android:textSize="14sp" />
            </LinearLayout>
            
            <!-- Aksesibilitas (jalur Terima order) -->
            <LinearLayout
                android:id="@+id/row_a11y_perm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingVertical="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/row_a11y_perm"
                    android:textColor="@color/row_title"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/val_a11y_perm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#202124"
                    android:textSize="14sp" />
            </LinearLayout>
                        
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </FrameLayout>

    <!-- Tombol kanan bawah -->
    <LinearLayout
        android:id="@+id/buttons_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Icon NT rahasia -->
        <ImageView
            android:id="@+id/btn_secret"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="14dp"
            android:elevation="6dp"
            android:src="@drawable/ic_secret"
            android:visibility="gone"
            android:contentDescription="@string/secret_menu" />

        <!-- 1. Autofokus + kompas -->
        <FrameLayout
            android:id="@+id/btn_autofocus"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_fab_circle"
            android:elevation="6dp">

            <ImageView
                android:id="@+id/img_compass"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_compass"
                android:contentDescription="@string/autofocus" />
        </FrameLayout>

        <!-- 2. Zoom in = zoom maksimal -->
        <FrameLayout
            android:id="@+id/btn_zoom_in"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_fab_circle"
            android:elevation="6dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_zoom_in"
                android:contentDescription="@string/zoom_in" />
        </FrameLayout>

        <!-- 3. Zoom out -->
        <FrameLayout
            android:id="@+id/btn_zoom_out"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_fab_circle"
            android:elevation="6dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_zoom_out"
                android:contentDescription="@string/zoom_out" />
        </FrameLayout>
    </LinearLayout>

    <!-- Tombol KIRI bawah : GRB, GJK, Favorite, Jitter -->
    <LinearLayout
        android:id="@+id/service_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|bottom"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 1. Play/stop GRB -->
        <FrameLayout
            android:id="@+id/btn_grb"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_fab_circle"
            android:elevation="6dp">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_marker_grb"
                android:contentDescription="@string/btn_grb" />

            <ImageView
                android:id="@+id/badge_grb"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="4dp"
                android:background="@drawable/bg_badge"
                android:padding="2dp"
                android:src="@drawable/ic_play" />
        </FrameLayout>

        <!-- 2. Play/stop GJK -->
        <FrameLayout
            android:id="@+id/btn_gjk"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_fab_circle"
            android:elevation="6dp">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_marker_gjk"
                android:contentDescription="@string/btn_gjk" />

            <ImageView
                android:id="@+id/badge_gjk"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="4dp"
                android:background="@drawable/bg_badge"
                android:padding="2dp"
                android:src="@drawable/ic_play" />
        </FrameLayout>

        <!-- 3. Favorite (coming soon) -->
        <FrameLayout
            android:id="@+id/btn_favorite"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_fab_circle"
            android:elevation="6dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_favorite"
                android:contentDescription="@string/btn_favorite" />
        </FrameLayout>

        <!-- 4. Jitter -->
        <FrameLayout
            android:id="@+id/btn_jitter"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_fab_circle"
            android:elevation="6dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_jitter"
                android:contentDescription="@string/btn_jitter" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
