<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <TextView
            android:id="@+id/tab_jitter_grb"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingVertical="10dp"
            android:text="@string/jitter_tab_grb"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tab_jitter_gjk"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingVertical="10dp"
            android:text="@string/jitter_tab_gjk"
            android:textSize="14sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1F000000" />

    <!-- ===== Halaman GRB ===== -->
    <LinearLayout
        android:id="@+id/page_jitter_grb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="6dp"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/btn_default_grb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/jitter_default" />

        <TextView
            android:id="@+id/label_step_grb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#202124"
            android:textSize="13sp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/slider_step_grb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="0.1"
            android:valueFrom="0.1"
            android:valueTo="5.0" />

        <TextView
            android:id="@+id/label_maxdist_grb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#202124"
            android:textSize="13sp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/slider_maxdist_grb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="0.1"
            android:valueFrom="0.1"
            android:valueTo="5.0" />

        <TextView
            android:id="@+id/label_interval_grb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#202124"
            android:textSize="13sp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/slider_interval_grb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="1"
            android:valueFrom="1"
            android:valueTo="5" />
    </LinearLayout>

    <!-- ===== Halaman GJK ===== -->
    <LinearLayout
        android:id="@+id/page_jitter_gjk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="6dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btn_default_gjk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/jitter_default" />

        <TextView
            android:id="@+id/label_step_gjk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#202124"
            android:textSize="13sp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/slider_step_gjk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="0.1"
            android:valueFrom="0.1"
            android:valueTo="5.0" />

        <TextView
            android:id="@+id/label_maxdist_gjk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#202124"
            android:textSize="13sp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/slider_maxdist_gjk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="0.1"
            android:valueFrom="0.1"
            android:valueTo="5.0" />

        <TextView
            android:id="@+id/label_interval_gjk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#202124"
            android:textSize="13sp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/slider_interval_gjk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="1"
            android:valueFrom="1"
            android:valueTo="5" />
    </LinearLayout>
</LinearLayout>
